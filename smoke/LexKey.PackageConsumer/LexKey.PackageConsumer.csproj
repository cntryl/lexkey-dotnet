<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LexKeySmokePackageVersion Condition="'$(LexKeySmokePackageVersion)' == ''">0.1.0</LexKeySmokePackageVersion>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/consumer-package-cache</RestorePackagesPath>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="Cntryl.LexKey" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Cntryl.LexKey" Version="$(LexKeySmokePackageVersion)" />
  </ItemGroup>
</Project>
